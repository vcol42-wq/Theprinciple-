@echo off
chcp 65001 > nul
title بناء نسخة الويب للنشر السحابي (Build Production Web)
color 0a
echo ==============================================================================
echo        بناء وتجميع نسخة الويب للنشر السحابي (Vercel / Netlify / Firebase)
echo ==============================================================================
echo.
cd /d "%~dp0"

echo [1/2] فحص الحزم...
if not exist "node_modules" (
    call npm install
)

echo.
echo [2/2] جاري بناء وتجميع ملفات الويب والـ PWA في مجلد dist...
call npm run build

if %ERRORLEVEL% EQU 0 (
    echo.
    echo ==============================================================================
    echo [✓] تم تجميع نسخة الويب بنجاح تام!
    echo المجلد الناتج: %~dp0dist
    echo يمكنك رفع محتويات مجلد dist مباشرة إلى أي استضافة مجانية مثل Vercel أو Netlify.
    echo ==============================================================================
    explorer "%~dp0dist"
) else (
    echo [X] حدث خطأ أثناء التجميع.
)
pause
