@echo off
chcp 65001 > nul
title تشغيل نسخة الويب الشاملة - The Principal Web
color 0b
echo ==============================================================================
echo        تشغيل نسخة الويب الشاملة (PWA) - نظام الإدارة المدرسية الموحد
echo        متوافقة مع: آيفون (iOS) | أندرويد | ويندوز | ماك | أي متصفح
echo ==============================================================================
echo.
cd /d "%~dp0"

echo [1/2] فحص وتثبيت الحزم (إن لم تكن مثبتة مسبقاً)...
if not exist "node_modules" (
    call npm install
)

echo.
echo [2/2] تشغيل خادم الويب المحلي...
echo يمكنك فتح الرابط الظاهر على هاتفك (آيفون أو أندرويد) عبر الواي فاي أو بالمتصفح:
call npm run dev -- --host
pause
